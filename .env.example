# -----------------------------------------------------------------------------
# ConnectEd Environment Configuration Template
# BSAU ICS Skill-Based OJT Placement and Company Verification System
# -----------------------------------------------------------------------------

APP_NAME=ConnectEd
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL 16 on Neon)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=connected
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# Neon direct host for running migrations (bypassing connection pooler)
DB_HOST_DIRECT=

# Framework State Drivers (Use database driver for Vercel/container deployment)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=documents

# Cloud Storage (S3-compatible: Cloudflare R2 / AWS S3 / Supabase)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ConnectEd Domain Settings
CURRENT_SCHOOL_YEAR=2026-2027
STUDENT_REGISTRATION_REQUIRES_APPROVAL=true
OPPORTUNITY_REQUIRES_APPROVAL=true
CONNECTED_DIRECT_UPLOAD=true
CONNECTED_AUDIT_IP=false

# Seeder Configuration
SEED_DEFAULT_PASSWORD=ConnectEd2026!
ALLOW_DEMO_SEED=true
